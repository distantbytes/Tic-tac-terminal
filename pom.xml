<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>page.codeberg.distantbytes</groupId>
    <artifactId>tic-tac-terminal</artifactId>
    <version>1.4.6-SNAPSHOT</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kotlin.jvmTarget>11</kotlin.jvmTarget>
        <kotlin.languageVersion>2.0</kotlin.languageVersion>
        <kotlin.apiVersion>2.0</kotlin.apiVersion>
        <kotlin.version>2.4.0</kotlin.version>
        
        <main.class>page.codeberg.distantbytes.tictacterminal.TicTacToeKt</main.class>
    </properties>

    <profiles>
        <profile>
            <id>modern-jdk</id>
            <activation>
                <jdk>[17,)</jdk>
            </activation>
            <properties>
            </properties>
        </profile>
        <profile>
            <id>legacy-jdk</id>
            <activation>
                <jdk>(1.8,16]</jdk>
            </activation>
            <properties>
                <kotlin.version>1.4.32</kotlin.version>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <jvmTarget>${kotlin.jvmTarget}</jvmTarget>
                    <languageVersion>${kotlin.languageVersion}</languageVersion>
                    <apiVersion>${kotlin.apiVersion}</apiVersion>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/kotlin.kotlin_module</resource>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>